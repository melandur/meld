<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stand-in for GtkSourceView's built-in "solarized-light" scheme, used
  only when no installed copy is found. GtkSourceView is
  LGPL-2.1-or-later; Solarized is by Ethan Schoonover.
-->
<style-scheme id="solarized-light" name="Solarized Light" version="1.0">
  <author>Ethan Schoonover</author>
  <description>Color scheme using Solarized light color palette</description>
  <metadata>
    <property name="variant">light</property>
    <property name="dark-variant">solarized-dark</property>
  </metadata>

  <color name="base03"  value="#002b36"/>
  <color name="base02"  value="#073642"/>
  <color name="base01"  value="#586e75"/>
  <color name="base00"  value="#657b83"/>
  <color name="base0"   value="#839496"/>
  <color name="base1"   value="#93a1a1"/>
  <color name="base2"   value="#eee8d5"/>
  <color name="base3"   value="#fdf6e3"/>
  <color name="yellow"  value="#b58900"/>
  <color name="orange"  value="#cb4b16"/>
  <color name="red"     value="#dc322f"/>
  <color name="magenta" value="#d33682"/>
  <color name="violet"  value="#6c71c4"/>
  <color name="blue"    value="#268bd2"/>
  <color name="cyan"    value="#2aa198"/>
  <color name="green"   value="#859900"/>

  <style name="text"                    foreground="base00" background="base3"/>
  <style name="selection"               foreground="base3" background="base1"/>
  <style name="cursor"                  foreground="base01"/>
  <style name="current-line"            background="base2"/>
  <style name="current-line-number"     background="base2"/>
  <style name="line-numbers"            foreground="base1" background="base2"/>
  <style name="draw-spaces"             foreground="base1"/>
  <style name="background-pattern"      background="base2"/>
  <style name="bracket-match"           foreground="base3" background="base1" bold="true"/>
  <style name="bracket-mismatch"        foreground="base3" background="red" bold="true"/>
  <style name="right-margin"            foreground="base1" background="base2"/>
  <style name="search-match"            foreground="base3" background="yellow"/>

  <style name="def:comment"             foreground="base1" italic="true"/>
  <style name="def:shebang"             foreground="base1" bold="true"/>
  <style name="def:doc-comment-element" italic="true"/>
  <style name="def:constant"            foreground="cyan"/>
  <style name="def:string"              foreground="cyan"/>
  <style name="def:special-char"        foreground="orange"/>
  <style name="def:number"              foreground="cyan"/>
  <style name="def:identifier"          foreground="blue"/>
  <style name="def:function"            foreground="blue"/>
  <style name="def:statement"           foreground="green"/>
  <style name="def:keyword"             foreground="green"/>
  <style name="def:type"                foreground="yellow"/>
  <style name="def:preprocessor"        foreground="orange"/>
  <style name="def:error"               foreground="red" bold="true"/>
  <style name="def:warning"             foreground="orange"/>
  <style name="def:note"                foreground="magenta" bold="true"/>
  <style name="def:net-address"         foreground="blue" underline="single"/>
  <style name="def:underlined"          underline="single"/>
  <style name="def:emphasis"            italic="true"/>
  <style name="def:strong-emphasis"     bold="true"/>
  <style name="def:heading"             foreground="blue" bold="true"/>
  <style name="def:insertion"           foreground="green"/>
  <style name="def:deletion"            foreground="red" strikethrough="true"/>

  <style name="diff:added-line"         foreground="green"/>
  <style name="diff:removed-line"       foreground="red"/>
  <style name="diff:changed-line"       foreground="yellow"/>
  <style name="diff:location"           foreground="blue"/>
  <style name="diff:special-case"       foreground="violet"/>
  <style name="diff:diff-file"          foreground="base01" bold="true"/>
</style-scheme>
