<!--
  Converted from the PyCharm-monokai IntelliJ colour scheme (parent
  Darcula). Generic def:* styles carry the Monokai mapping so that every
  language gets it through def.lang; language-specific styles only
  override where the generic mapping would be wrong or too flat.

  This scheme deliberately has no parent scheme, so that no styles leak
  in from elsewhere; Meld's own styles are defined explicitly below.
-->
<style-scheme id="meld-monokai" name="Monokai (PyCharm)" version="1.0">
  <author>Meld contributors</author>
  <description>Monokai colors from the PyCharm-monokai theme</description>

  <metadata>
    <property name="variant">dark</property>
    <property name="light-variant">meld-lens-light</property>
  </metadata>

  <!-- Monokai palette -->
  <color name="white"            value="#ffffff"/>
  <color name="background"       value="#2b2b2b"/>
  <color name="comment"          value="#75715e"/>
  <color name="yellow"           value="#e6db74"/>
  <color name="purple"           value="#ae81ff"/>
  <color name="pink"             value="#f92672"/>
  <color name="cyan"             value="#66d9ef"/>
  <color name="green"            value="#a6e22e"/>
  <color name="orange"           value="#fd971f"/>
  <color name="red"              value="#ff0000"/>

  <!-- Darcula values that the PyCharm scheme inherits -->
  <color name="selection"        value="#214283"/>
  <color name="current-line"     value="#323232"/>
  <color name="gutter"           value="#313335"/>
  <color name="gutter-fg"        value="#606366"/>
  <color name="gutter-fg-caret"  value="#a4a3a3"/>
  <color name="caret"            value="#bbbbbb"/>
  <color name="margin"           value="#383838"/>
  <color name="whitespace"       value="#505050"/>

  <!-- PyCharm's identifier and write-identifier under caret -->
  <color name="caret-identifier" value="#344134"/>
  <color name="write-identifier" value="#40332b"/>

  <!-- Global settings -->
  <style name="text"                  foreground="white" background="background"/>
  <style name="selection"             background="selection"/>
  <style name="selection-unfocused"   background="selection"/>
  <style name="cursor"                foreground="caret"/>
  <style name="secondary-cursor"      foreground="gutter-fg"/>
  <style name="current-line"          background="current-line"/>
  <style name="line-numbers"          foreground="gutter-fg" background="gutter"/>
  <style name="current-line-number"   foreground="gutter-fg-caret" background="gutter"/>
  <style name="bracket-match"         foreground="white" background="caret-identifier"/>
  <style name="bracket-mismatch"      foreground="white" background="pink"/>
  <style name="right-margin"          foreground="margin" background="#2e2e2e"/>
  <style name="draw-spaces"           foreground="whitespace"/>
  <style name="background-pattern"    background="gutter"/>
  <style name="search-match"          foreground="white" background="write-identifier"/>
  <style name="snippet-focus"         background="caret-identifier"/>
  <style name="map-overlay"           background="#rgba(200, 200, 200, 0.25)"/>

  <!-- Comments; PyCharm's docstrings are italic yellow, with bold
       italic doc tags -->
  <style name="def:comment"               foreground="comment"/>
  <style name="def:shebang"               foreground="comment" bold="true"/>
  <style name="def:doc-comment"           foreground="yellow" italic="true"/>
  <style name="def:doc-comment-element"   foreground="yellow" bold="true" italic="true"/>

  <!-- Constants -->
  <style name="def:constant"              foreground="purple"/>
  <style name="def:special-constant"      foreground="purple"/>
  <style name="def:boolean"               foreground="purple"/>
  <style name="def:string"                foreground="yellow"/>
  <style name="def:character"             foreground="yellow"/>
  <style name="def:special-char"          foreground="purple"/>
  <style name="def:number"                foreground="purple"/>
  <style name="def:floating-point"        foreground="purple"/>
  <style name="def:decimal"               foreground="purple"/>
  <style name="def:base-n-integer"        foreground="purple"/>
  <style name="def:complex"               foreground="purple"/>

  <!-- Identifiers, functions and types -->
  <style name="def:identifier"            foreground="white"/>
  <style name="def:variable"              foreground="white"/>
  <style name="def:function"              foreground="green"/>
  <style name="def:builtin"               foreground="cyan"/>
  <style name="def:type"                  foreground="cyan"/>

  <!-- Statements, keywords and operators -->
  <style name="def:statement"             foreground="cyan" bold="true"/>
  <style name="def:keyword"               foreground="cyan" bold="true"/>
  <style name="def:reserved"              foreground="pink"/>
  <style name="def:operator"              foreground="pink"/>
  <style name="def:preprocessor"          foreground="pink"/>

  <!-- Diagnostics; invalid escapes have a red underline in PyCharm -->
  <style name="def:error"                 underline="error" underline-color="red"/>
  <style name="def:warning"               foreground="orange"/>
  <style name="def:note"                  foreground="orange" bold="true"/>
  <style name="def:net-address"           foreground="cyan" underline="single"/>
  <style name="def:underlined"            underline="single"/>

  <!-- Markup -->
  <style name="def:emphasis"              italic="true"/>
  <style name="def:strong-emphasis"       bold="true"/>
  <style name="def:heading"               foreground="green" bold="true"/>
  <style name="def:inline-code"           foreground="yellow"/>
  <style name="def:preformatted-section"  foreground="yellow"/>
  <style name="def:link-text"             foreground="cyan"/>
  <style name="def:link-symbol"           foreground="pink"/>
  <style name="def:link-destination"      foreground="yellow" underline="single"/>
  <style name="def:list-marker"           foreground="pink"/>
  <style name="def:blockquote-marker"     foreground="comment"/>
  <style name="def:thematic-break"        foreground="comment"/>
  <style name="def:insertion"             foreground="green"/>
  <style name="def:deletion"              foreground="pink" strikethrough="true"/>

  <!-- Python, following the PyCharm token colours. GtkSourceView
       doesn't tokenise parameters or keyword arguments, but self and
       cls are special variables. -->
  <style name="python:keyword"            foreground="cyan" bold="true"/>
  <style name="python:module-handler"     foreground="cyan" bold="true"/>
  <style name="python:boolean"            foreground="cyan" bold="true"/>
  <style name="python:builtin-constant"   foreground="cyan" bold="true"/>
  <style name="python:builtin-function"   foreground="cyan"/>
  <style name="python:builtin-object"     foreground="cyan"/>
  <style name="python:special-variable"   foreground="orange"/>
  <style name="python:function-name"      foreground="green" bold="true"/>
  <style name="python:class-name"         foreground="white" bold="true"/>
  <style name="python:decorator"          foreground="green"/>
  <style name="python:operator"           foreground="pink"/>
  <style name="python:string"             foreground="yellow"/>
  <style name="python:multiline-string"   foreground="yellow" italic="true"/>
  <style name="python:escaped-char"       foreground="purple"/>
  <style name="python:format"             foreground="purple"/>

  <!-- Shell: variables would otherwise share keyword colours -->
  <style name="sh:variable"               foreground="orange"/>
  <style name="sh:common-command"         foreground="cyan"/>

  <!-- XML and HTML -->
  <style name="xml:element-name"          foreground="pink"/>
  <style name="xml:attribute-name"        foreground="green"/>
  <style name="xml:attribute-value"       foreground="yellow"/>
  <style name="xml:entity"                foreground="purple"/>
  <style name="xml:doctype"               foreground="comment"/>
  <style name="xml:processing-instruction" foreground="comment"/>
  <style name="xml:cdata-delim"           foreground="comment"/>

  <!-- CSS -->
  <style name="css:property-name"         foreground="cyan"/>
  <style name="css:type-selector"         foreground="pink"/>
  <style name="css:class-selector"        foreground="green"/>
  <style name="css:id-selector"           foreground="green"/>

  <!-- Keys in data formats -->
  <style name="json:keyname"              foreground="pink"/>
  <style name="yaml:map-key"              foreground="pink"/>

  <!-- Diff (patch files) -->
  <style name="diff:added-line"           foreground="green"/>
  <style name="diff:removed-line"         foreground="pink"/>
  <style name="diff:changed-line"         foreground="yellow"/>
  <style name="diff:location"             foreground="comment"/>
  <style name="diff:special-case"         foreground="purple"/>
  <style name="diff:diff-file"            foreground="white" bold="true"/>

  <!-- Meld -->
  <style name="meld:insert" background="#3a4a2a" foreground="#a6e22e" line-background="#6c8f2a"/>
  <style name="meld:replace" background="#2f4248" foreground="#66d9ef" line-background="#3f8fa3"/>
  <style name="meld:conflict" background="#5c2424" foreground="#ff6464" line-background="#d13b3b"/>
  <style name="meld:delete" background="#4a2a33" foreground="#f92672" line-background="#a3244f"/>
  <style name="meld:error" background="#4d4422" foreground="#e6db74" line-background="#9a8a2a"/>
  <style name="meld:inline" background="#2f6575"/>
  <style name="meld:current-line-highlight" foreground="#eeeeee" background="#rgba(255, 255, 255, 0.06)"/>
  <style name="meld:unknown-text" foreground="#8a8a8a"/>
  <style name="meld:syncpoint-outline" foreground="#bbbbbb"/>
  <style name="meld:current-chunk-highlight" background="#rgba(255, 255, 255, 0.06)"/>
  <style name="meld:overscroll" background="#rgba(255, 255, 255, 0.05)"/>
  <style name="meld:dimmed" foreground="#75715e"/>
</style-scheme>
